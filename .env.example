# Общие настройки
PROJECT_NAME=Media Streaming Project
TZ=Europe/Moscow
PUID=1000
PGID=1000

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:////app/data/app.db
LOG_LEVEL=INFO

# Поиск и подготовка контента
CONTENT_PROVIDER=multi_source
USER_SEARCH_ADAPTERS=jackett
INGEST_ADAPTER=local_demo
LOCAL_CATALOG_PATH=/app/catalogs/local_catalog.json

# Локальная медиатека внутри Docker
MEDIA_ROOT=/media
MOVIES_DIR=/media/movies
MEDIA_PUBLIC_BASE_URL=

# Jellyfin — заполнить после локальной настройки
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=

# Internet Archive
INTERNET_ARCHIVE_BASE_URL=https://archive.org
INTERNET_ARCHIVE_SEARCH_ROWS=5
INTERNET_ARCHIVE_MAX_FILE_SIZE_MB=250

# Transmission
TRANSMISSION_RPC_URL=http://transmission:9091/transmission/rpc
TRANSMISSION_RPC_USERNAME=
TRANSMISSION_RPC_PASSWORD=
TRANSMISSION_BACKEND_DOWNLOADS_DIR=/downloads/transmission

# Jackett — ключ хранится только в локальном .env
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=
JACKETT_CATEGORIES=2000,2020,2030,2040,2050
JACKETT_SEARCH_LIMIT=20
JACKETT_TIMEOUT_SECONDS=120
JACKETT_REQUIRE_RUSSIAN_AUDIO=true
JACKETT_STRICT_RUSSIAN_ONLY=true
JACKETT_EXCLUDE_BAD_QUALITY=true

# Авторизация
PROFILE_AUTH_ENABLED=false
PROFILE_DEFAULT_PIN=
PROFILE_SECOND_PIN=
LEGACY_PROFILE_HEADERS_ENABLED=false
REGISTRATION_ENABLED=true
REGISTRATION_INVITE_CODE=
AUTH_SESSION_TTL_DAYS=30
MEDIA_STREAM_TOKEN_TTL_MINUTES=360
